{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StancePost",
  "type": "object",
  "required": [
    "id",
    "authorId",
    "authorName",
    "title",
    "content",
    "topic",
    "upvotes",
    "downvotes",
    "replyCount",
    "moderationStatus",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string" },
    "authorId": { "type": "string" },
    "authorName": { "type": "string" },
    "authorAvatar": { "type": "string" },
    "title": { "type": "string", "minLength": 5, "maxLength": 150 },
    "content": { "type": "string", "minLength": 10, "maxLength": 2000 },
    "topic": {
      "type": "string",
      "enum": ["tech", "design", "open-source", "campus", "career", "general"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 5
    },
    "upvotes": { "type": "integer", "minimum": 0 },
    "downvotes": { "type": "integer", "minimum": 0 },
    "replyCount": { "type": "integer", "minimum": 0 },
    "moderationStatus": {
      "type": "string",
      "enum": ["approved", "pending", "flagged"]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
