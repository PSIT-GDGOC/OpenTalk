# Firebase Configuration (Optional for emulator mode)
VITE_FIREBASE_API_KEY=demo-opentalk-key
VITE_FIREBASE_AUTH_DOMAIN=demo-opentalk.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-opentalk
